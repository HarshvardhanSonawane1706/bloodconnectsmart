<!-- =========================================================
     REGISTRATION MODAL
========================================================= -->

<div
    class="modal-overlay"
    id="registrationModal"
>

    <div class="modal-card glass-card">

        <button
            class="modal-close"
            data-close="registrationModal"
        >
            ×
        </button>

        <div class="modal-title">

            <span>STEP <b id="registrationStepNumber">1</b> OF 3</span>

            <h2 id="registrationTitle">
                Donor information
            </h2>

            <p id="registrationSubtitle">
                Tell us who is attending this camp.
            </p>

        </div>

        <form id="registrationForm">

            <div
                class="registration-step active"
                data-step="1"
            >

                <label class="field">
                    <span>Full name</span>
                    <input
                        id="regName"
                        type="text"
                        required
                    >
                </label>

                <label class="field">
                    <span>Phone</span>
                    <input
                        id="regPhone"
                        type="tel"
                        required
                    >
                </label>

                <label class="field">
                    <span>Email</span>
                    <input
                        id="regEmail"
                        type="email"
                        required
                    >
                </label>

                <div class="two-fields">

                    <label class="field">
                        <span>Blood group</span>

                        <select id="regBlood" required>
                            <option value="">Select</option>
                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                            <option>O+</option>
                            <option>O-</option>
                        </select>

                    </label>

                    <label class="field">
                        <span>Preferred language</span>

                        <select id="regLanguage">
                            <option>English</option>
                            <option>Hindi</option>
                            <option>Marathi</option>
                            <option>Tamil</option>
                            <option>Telugu</option>
                            <option>Bengali</option>
                            <option>Kannada</option>
                            <option>Malayalam</option>
                        </select>

                    </label>

                </div>

            </div>


            <div
                class="registration-step"
                data-step="2"
            >

                <div class="consent-box">

                    <div>
                        <strong>This camp reminders</strong>
                        <small>
                            Allow reminders for this specific camp.
                        </small>
                    </div>

                    <input
                        type="checkbox"
                        id="regCampConsent"
                        checked
                    >

                    <span class="toggle"></span>

                </div>

                <div class="consent-box">

                    <div>
                        <strong>Emergency requests</strong>
                        <small>
                            Allow future emergency mobilisation notifications.
                        </small>
                    </div>

                    <input
                        type="checkbox"
                        id="regEmergencyConsent"
                        checked
                    >

                    <span class="toggle"></span>

                </div>

                <div class="consent-box">

                    <div>
                        <strong>WhatsApp / SMS</strong>
                        <small>
                            Receive permitted communication through selected channels.
                        </small>
                    </div>

                    <input
                        type="checkbox"
                        id="regCommunicationConsent"
                        checked
                    >

                    <span class="toggle"></span>

                </div>

                <div class="consent-warning">
                    You can withdraw communication consent through your Donor Space.
                </div>

            </div>


            <div
                class="registration-step"
                data-step="3"
            >

                <div class="precheck">

                    <div class="precheck-icon">✓</div>

                    <h3>Administrative pre-check</h3>

                    <p>
                        This checklist is not medical screening.
                        Final eligibility is determined by qualified healthcare
                        professionals at the camp.
                    </p>

                    <label class="checkbox">
                        <input
                            type="checkbox"
                            id="ageCheck"
                        >
                        <span>I confirm I meet the stated age requirement.</span>
                    </label>

                    <label class="checkbox">
                        <input
                            type="checkbox"
                            id="weightCheck"
                        >
                        <span>I confirm I meet the stated weight requirement.</span>
                    </label>

                    <label class="checkbox">
                        <input
                            type="checkbox"
                            id="professionalCheck"
                        >
                        <span>I understand final medical eligibility is checked on-site.</span>
                    </label>

                </div>

            </div>


            <div class="registration-actions">

                <button
                    type="button"
                    class="secondary-btn"
                    id="registrationBack"
                >
                    Back
                </button>

                <button
                    type="button"
                    class="primary-btn"
                    id="registrationNext"
                >
                    Continue
                    <span>→</span>
                </button>

            </div>

        </form>

    </div>

</div>


