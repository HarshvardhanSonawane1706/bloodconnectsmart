<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Blood Connect | Intelligent Blood Mobilisation Platform</title>

    <meta
        name="description"
        content="Blood Connect - Intelligent blood donation mobilisation, camp coordination and emergency donor response platform."
    >

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <!-- Leaflet CSS for Interactive Maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link rel="stylesheet" href="style.css">
</head>

<body>

<!-- =========================================================
     AUTHENTICATION
========================================================= -->

<div id="authScreen" class="auth-screen">

    <div class="auth-orb orb-1"></div>
    <div class="auth-orb orb-2"></div>
    <div class="auth-orb orb-3"></div>

    <div class="auth-wrapper">

        <div class="auth-brand">

            <div class="brand large-brand">
                <span class="brand-mark">✦</span>
                <span>Blood<span>Connect</span></span>
            </div>

            <div class="auth-tag">
                NATIONAL BLOOD MOBILISATION NETWORK
            </div>

            <h1>
                A smarter network
                <span>for every donation.</span>
            </h1>

            <p>
                Discover camps, coordinate emergency mobilisation,
                manage donor communication and turn community response
                into an intelligent digital network.
            </p>

            <div class="auth-highlights">

                <div class="auth-highlight">
                    <div class="highlight-icon">◇</div>
                    <div>
                        <strong>Smart Camp Discovery</strong>
                        <small>Find upcoming and ongoing donation camps.</small>
                    </div>
                </div>

                <div class="auth-highlight">
                    <div class="highlight-icon cyan">⌁</div>
                    <div>
                        <strong>Emergency Mobilisation</strong>
                        <small>Coordinate consent-aware donor response.</small>
                    </div>
                </div>

                <div class="auth-highlight">
                    <div class="highlight-icon red">+</div>
                    <div>
                        <strong>Intelligent Matching</strong>
                        <small>Blood group, region, language and HLA fields.</small>
                    </div>
                </div>

                <div class="auth-highlight">
                    <div class="highlight-icon green">✓</div>
                    <div>
                        <strong>Consent First</strong>
                        <small>Keep donor communication transparent.</small>
                    </div>
                </div>

            </div>

            <div class="auth-stat-strip">

                <div>
                    <strong>24K+</strong>
                    <span>Donors</span>
                </div>

                <div>
                    <strong>180+</strong>
                    <span>Camps</span>
                </div>

                <div>
                    <strong>28</strong>
                    <span>Regions</span>
                </div>

            </div>

        </div>


        <div class="auth-card glass-card">

            <div class="auth-card-status">
                <span class="status-pulse"></span>
                Secure Blood Connect Portal
            </div>

            <!-- PRIMARY ROLE SELECTION: DONOR VS RECIPIENT -->
            <div class="auth-role-tabs">
                <button type="button" class="role-tab active" data-role="donor" id="roleBtnDonor">
                    <span class="role-icon">❤️</span>
                    <div class="role-info">
                        <strong>DONOR</strong>
                        <small>Donate blood & save lives</small>
                    </div>
                </button>
                <button type="button" class="role-tab" data-role="recipient" id="roleBtnRecipient">
                    <span class="role-icon">🏥</span>
                    <div class="role-info">
                        <strong>RECIPIENT</strong>
                        <small>Request blood & patient care</small>
                    </div>
                </button>
            </div>

            <!-- SUB-TOGGLE: SIGN IN (ALREADY REGISTERED) VS NEW REGISTRATION -->
            <div class="auth-tabs">
                <button
                    type="button"
                    class="auth-tab active"
                    data-auth-tab="signin"
                    id="tabSignIn"
                >
                    Already Registered? Sign In
                </button>

                <button
                    type="button"
                    class="auth-tab"
                    data-auth-tab="signup"
                    id="tabSignUp"
                >
                    New Registration
                </button>
            </div>

            <!-- ENTITY TYPE TOGGLE: INDIVIDUAL VS ORGANIZATION -->
            <div class="entity-toggle-wrapper">
                <span class="entity-label" id="entityToggleLabel">Account Type:</span>
                <div class="entity-toggle">
                    <button type="button" class="entity-btn active" data-entity="individual" id="entityBtnIndividual">
                        <span>👤</span> Individual
                    </button>
                    <button type="button" class="entity-btn" data-entity="organization" id="entityBtnOrg">
                        <span>🏢</span> Organization
                    </button>
                </div>
            </div>

            <!-- ==============================================
                 SIGN IN FORM (ALREADY REGISTERED)
            =============================================== -->
            <form id="signInForm" class="auth-form active">

                <div class="form-title">
                    <h2 id="signInHeading">Welcome Back, Donor</h2>
                    <p id="signInSubheading">Sign in to your Individual Donor account</p>
                </div>

                <label class="field">
                    <span>Email, phone, or ID proof</span>
                    <input
                        id="loginIdentifier"
                        type="text"
                        placeholder="you@example.com or ID Number"
                        required
                    >
                </label>

                <label class="field">
                    <span>Password</span>

                    <div class="password-field">
                        <input
                            id="loginPassword"
                            type="password"
                            placeholder="Enter password"
                            value="password123"
                            required
                        >
                        <button
                            type="button"
                            class="password-toggle"
                            data-password="loginPassword"
                        >
                            ◉
                        </button>
                    </div>
                </label>

                <div class="auth-row">
                    <label class="checkbox">
                        <input type="checkbox" checked>
                        <span>Remember me</span>
                    </label>

                    <button
                        type="button"
                        class="link-button"
                        id="forgotPassword"
                    >
                        Forgot password?
                    </button>
                </div>

                <button class="primary-btn wide" type="submit" id="signInSubmitBtn">
                    <span>Sign In to Blood Connect</span>
                    <b>→</b>
                </button>

                <!-- QUICK DEMO LOGINS -->
                <div class="demo-logins-box">
                    <div class="demo-title">
                        <span>⚡</span> Fast Demo Access:
                    </div>
                    <div class="demo-buttons-grid">
                        <button type="button" class="demo-chip-btn" data-demo="donor-indiv">
                            <span>❤️👤</span> Donor (Individual)
                        </button>
                        <button type="button" class="demo-chip-btn" data-demo="donor-org">
                            <span>❤️🏢</span> Donor (Org)
                        </button>
                        <button type="button" class="demo-chip-btn" data-demo="recipient-indiv">
                            <span>🏥👤</span> Recipient (Indiv)
                        </button>
                        <button type="button" class="demo-chip-btn" data-demo="recipient-org">
                            <span>🏥🏢</span> Recipient (Org)
                        </button>
                    </div>
                </div>

            </form>


            <!-- ==============================================
                 SIGN UP FORM (NEW REGISTRATION)
            =============================================== -->
            <form id="signUpForm" class="auth-form">

                <div class="form-title">
                    <h2 id="signUpHeading">Register as Individual Donor</h2>
                    <p id="signUpSubheading">Join India's intelligent blood mobilisation network</p>
                </div>

                <!-- INDIVIDUAL FIELDS -->
                <div id="individualSignupFields">

                    <div class="two-fields">
                        <label class="field">
                            <span>Full name</span>
                            <input
                                id="signupName"
                                type="text"
                                placeholder="Your full name"
                                required
                            >
                        </label>

                        <label class="field">
                            <span>Age</span>
                            <input
                                id="signupAge"
                                type="number"
                                min="18"
                                max="75"
                                placeholder="Age (e.g. 24)"
                                required
                            >
                        </label>
                    </div>

                    <div class="two-fields">
                        <label class="field">
                            <span>Contact Phone</span>
                            <input
                                id="signupPhone"
                                type="tel"
                                placeholder="+91 XXXXX XXXXX"
                                required
                            >
                        </label>

                        <label class="field">
                            <span>Email</span>
                            <input
                                id="signupEmail"
                                type="email"
                                placeholder="you@example.com"
                                required
                            >
                        </label>
                    </div>

                    <!-- ID PROOF -->
                    <div class="two-fields">
                        <label class="field">
                            <span>ID Proof Document</span>
                            <select id="signupIdType" required>
                                <option value="Aadhaar Card">Aadhaar Card</option>
                                <option value="Voter ID">Voter ID</option>
                                <option value="Driving License">Driving License</option>
                                <option value="Passport">Passport</option>
                                <option value="ABHA Health ID">ABHA Health ID</option>
                            </select>
                        </label>

                        <label class="field">
                            <span>ID Proof Number</span>
                            <input
                                id="signupIdProof"
                                type="text"
                                placeholder="e.g. 4829-1928-3849"
                                required
                            >
                        </label>
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label class="upload-pill" id="indivUploadLabel">
                            <input type="file" id="signupIdFile" style="display:none;">
                            <span>📎 Attach ID Proof Document (PDF/Photo)</span>
                        </label>
                        <small class="field-hint">Securely encrypted & verified for genuine mobilization.</small>
                    </div>

                    <!-- BLOOD GROUP & HLA TYPING -->
                    <div class="two-fields">
                        <label class="field">
                            <span id="indivBloodLabel">Blood Group</span>
                            <select id="signupBlood" required>
                                <option value="">Select Blood Group</option>
                                <option>A+</option>
                                <option>A-</option>
                                <option>B+</option>
                                <option>B-</option>
                                <option>AB+</option>
                                <option>AB-</option>
                                <option>O+</option>
                                <option>O-</option>
                            </select>
                        </label>

                        <label class="field">
                            <span>HLA Typing <small>(Optional)</small></span>
                            <input
                                id="signupHla"
                                type="text"
                                placeholder="e.g. HLA-A*02, HLA-B*07"
                            >
                            <small class="field-hint">For platelet & marrow compatibility</small>
                        </label>
                    </div>

                    <!-- ADDRESS -->
                    <label class="field">
                        <span>Residential Address</span>
                        <input
                            id="signupAddress"
                            type="text"
                            placeholder="Street, locality, landmark"
                            required
                        >
                    </label>

                    <div class="two-fields">
                        <label class="field">
                            <span>City / Region</span>
                            <input
                                id="signupCity"
                                type="text"
                                placeholder="e.g. Nagpur"
                                required
                            >
                        </label>

                        <label class="field">
                            <span>Pin Code</span>
                            <input
                                id="signupPincode"
                                type="text"
                                placeholder="e.g. 440001"
                                required
                            >
                        </label>
                    </div>

                </div>


                <!-- ORGANIZATION FIELDS (HIDDEN BY DEFAULT) -->
                <div id="organizationSignupFields" style="display: none;">

                    <label class="field">
                        <span>Name of Organization</span>
                        <input
                            id="signupOrgName"
                            type="text"
                            placeholder="e.g. Metro Care Hospital / Red Cross Society / City Blood Centre"
                        >
                    </label>

                    <div class="two-fields">
                        <label class="field">
                            <span>Contact Person / Officer</span>
                            <input
                                id="signupOrgContactPerson"
                                type="text"
                                placeholder="Dr. / Officer Name"
                            >
                        </label>

                        <label class="field">
                            <span>Official Phone</span>
                            <input
                                id="signupOrgPhone"
                                type="tel"
                                placeholder="+91 XXXXX XXXXX"
                            >
                        </label>
                    </div>

                    <label class="field">
                        <span>Official Email</span>
                        <input
                            id="signupOrgEmail"
                            type="email"
                            placeholder="admin@organisation.org"
                        >
                    </label>

                    <!-- ORG ID PROOF / REGISTRATION -->
                    <div class="two-fields">
                        <label class="field">
                            <span>Org ID Proof / License Type</span>
                            <select id="signupOrgIdType">
                                <option value="Hospital Clinical Establishment License">Hospital License</option>
                                <option value="State Blood Transfusion Council (SBTC)">SBTC Blood Bank License</option>
                                <option value="NGO / Trust Registration Certificate">NGO / Trust Reg No.</option>
                                <option value="Corporate Identification Number (CIN)">Corporate CIN</option>
                            </select>
                        </label>

                        <label class="field">
                            <span>License / Reg Number</span>
                            <input
                                id="signupOrgIdProof"
                                type="text"
                                placeholder="e.g. MH-HOSP-2024-8841"
                            >
                        </label>
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label class="upload-pill" id="orgUploadLabel">
                            <input type="file" id="signupOrgIdFile" style="display:none;">
                            <span>📎 Attach Registration / License Document</span>
                        </label>
                        <small class="field-hint">Verified under National Blood Safety & Mobilisation standards.</small>
                    </div>

                    <!-- BLOOD GROUP (DONATING / RECEIVING) -->
                    <label class="field">
                        <span id="orgBloodLabel">Blood Groups (Donating / Handled)</span>
                        <select id="signupOrgBlood">
                            <option value="All Blood Groups (Full Inventory)">All Blood Groups (Full Inventory)</option>
                            <option value="Universal & Critical (O+, O-, B+, B-)">Universal & Critical (O+, O-, B+, B-)</option>
                            <option value="A+, B+, O+, AB+ (Common Groups)">Common Groups (A+, B+, O+, AB+)</option>
                            <option value="Rare Blood Groups & Platelets">Rare Blood Groups & Platelets</option>
                            <option value="Specific Emergency Units">Specific Emergency Units</option>
                        </select>
                    </label>

                    <!-- ORG ADDRESS -->
                    <label class="field">
                        <span>Organization Facility Address</span>
                        <input
                            id="signupOrgAddress"
                            type="text"
                            placeholder="Building, Health Campus, Street"
                        >
                    </label>

                    <div class="two-fields">
                        <label class="field">
                            <span>City</span>
                            <input
                                id="signupOrgCity"
                                type="text"
                                placeholder="e.g. Mumbai"
                            >
                        </label>

                        <label class="field">
                            <span>Pin Code</span>
                            <input
                                id="signupOrgPincode"
                                type="text"
                                placeholder="e.g. 400001"
                            >
                        </label>
                    </div>

                </div>


                <!-- PASSWORD & CONSENT -->
                <label class="field">
                    <span>Create Password</span>
                    <input
                        id="signupPassword"
                        type="password"
                        placeholder="Create a strong password"
                        value="password123"
                        required
                    >
                </label>

                <label class="checkbox terms">
                    <input type="checkbox" required checked>
                    <span>
                        I confirm that the ID proof and details provided are valid and agree to Blood Connect's consent & mobilisation protocols.
                    </span>
                </label>

                <button class="primary-btn wide" type="submit" id="signUpSubmitBtn">
                    <span id="signUpBtnText">Create Individual Donor Account</span>
                    <b>→</b>
                </button>

            </form>

        </div>

    </div>
</div>


<!-- =========================================================
     MAIN APPLICATION
========================================================= -->

<div id="app" class="app hidden">

    <div class="background-grid"></div>

    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <header class="navbar glass-card">

        <button class="brand brand-button" data-section="home">
            <span class="brand-mark">✦</span>
            <span>Blood<span>Connect</span></span>
        </button>

        <nav class="desktop-nav">

            <button
                class="nav-item active"
                data-section="home"
            >
                Overview
            </button>

            <button
                class="nav-item"
                data-section="camps"
            >
                Camps
            </button>

            <button
                class="nav-item"
                data-section="emergency"
            >
                Emergency
                <span class="nav-alert">27</span>
            </button>

            <button
                class="nav-item"
                data-section="intelligence"
            >
                Intelligence
            </button>

            <button
                class="nav-item"
                data-section="donor"
                id="navDonorSpace"
            >
                Donor Space
            </button>

            <button
                class="nav-item"
                data-section="recipient"
                id="navRecipientSpace"
            >
                Recipient Space
            </button>

        </nav>

        <div class="nav-right">

            <button
                class="nav-icon-btn"
                id="commandButton"
                title="Command palette"
            >
                ⌘
            </button>

            <button
                class="nav-icon-btn notification-button"
                id="notificationButton"
                title="Notifications"
            >
                ♢
                <span class="notification-count" id="headerNotificationCount">3</span>
            </button>

            <button
                class="theme-button"
                id="themeToggle"
            >
                <span class="theme-symbol">☾</span>
                <span>Dark Mode</span>
            </button>

            <button
                class="profile-button"
                id="profileButton"
            >
                <span class="avatar" id="navAvatar">MQ</span>

                <span class="profile-info">
                    <strong id="navName">Mahi Qureshi</strong>
                    <small id="navRole">Donor • Individual</small>
                </span>

                <span>⌄</span>
            </button>

            <button
                class="mobile-menu-btn"
                id="mobileMenuButton"
            >
                ☰
            </button>

        </div>

    </header>


    <!-- MOBILE NAV -->

    <div
        class="mobile-nav glass-card"
        id="mobileNav"
    >
        <button data-section="home">Overview</button>
        <button data-section="camps">Camps</button>
        <button data-section="emergency">Emergency</button>
        <button data-section="intelligence">Intelligence</button>
        <button data-section="donor" id="mobileNavDonor">Donor Space</button>
        <button data-section="recipient" id="mobileNavRecipient">Recipient Space</button>
    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="main">


        <!-- =================================================
             HOME
        ================================================== -->

        <section
            class="page-section active"
            id="home"
        >

            <div class="hero">

                <div class="hero-copy">

                    <div class="eyebrow">
                        <span class="live-indicator"></span>
                        NATIONAL BLOOD MOBILISATION NETWORK
                    </div>

                    <h1>
                        A smarter network
                        <span>for every donation.</span>
                    </h1>

                    <p>
                        Discover donation camps, respond to emergency
                        mobilisation requests and manage your donor journey
                        through one intelligent platform.
                    </p>

                    <div class="hero-buttons">

                        <button
                            class="primary-btn"
                            data-section="camps"
                        >
                            Explore Camps
                            <b>→</b>
                        </button>

                        <button
                            class="secondary-btn"
                            data-section="emergency"
                        >
                            Emergency Request
                            <b>↗</b>
                        </button>

                    </div>

                    <div class="hero-trust">

                        <span>✓ Consent-aware</span>
                        <span>✓ Multi-language</span>
                        <span>✓ Data-driven</span>
                        <span>✓ Scalable</span>

                    </div>

                </div>


                <!-- NETWORK CARD -->

                <div class="network-card glass-card">

                    <div class="network-card-head">

                        <div>
                            <span>LIVE NETWORK</span>
                            <h3>Mobilisation Pulse</h3>
                        </div>

                        <div class="live-badge">
                            <i></i>
                            LIVE
                        </div>

                    </div>

                    <div class="network-visual">

                        <div class="network-lines"></div>

                        <div class="network-point point-1">D</div>
                        <div class="network-point point-2">C</div>
                        <div class="network-point point-3">E</div>
                        <div class="network-point point-4">+</div>

                        <div class="network-core">
                            <div class="core-ring"></div>
                            <strong>18,426</strong>
                            <span>active donors</span>
                        </div>

                    </div>

                    <div class="network-metrics">

                        <div>
                            <i class="blue"></i>
                            <span>Active</span>
                            <strong>18.4K</strong>
                        </div>

                        <div>
                            <i class="cyan"></i>
                            <span>Responding</span>
                            <strong>2.8K</strong>
                        </div>

                        <div>
                            <i class="red"></i>
                            <span>Emergency</span>
                            <strong>27</strong>
                        </div>

                    </div>

                </div>

            </div>


            <!-- SMART SEARCH -->

            <div class="smart-search glass-card">

                <div class="smart-search-head">

                    <div class="smart-icon">✦</div>

                    <div>
                        <span>Blood Connect Smart Search</span>
                        <small>
                            Search camps, regions, blood groups and optional HLA information
                        </small>
                    </div>

                </div>

                <div class="search-grid">

                    <div class="search-control large">

                        <span>⌕</span>

                        <input
                            id="smartSearch"
                            type="text"
                            placeholder="Search camps, cities or organisations..."
                        >

                    </div>

                    <select id="searchBlood">
                        <option value="">Blood Group</option>
                        <option>A+</option>
                        <option>A-</option>
                        <option>B+</option>
                        <option>B-</option>
                        <option>AB+</option>
                        <option>AB-</option>
                        <option>O+</option>
                        <option>O-</option>
                    </select>


                    <!-- HLA INPUT -->

                    <div class="search-control">

                        <span class="hla-label">HLA</span>

                        <input
                            id="hlaSearch"
                            type="text"
                            placeholder="Enter HLA typing"
                        >

                    </div>


                    <select id="searchLocation">

                        <option value="">Location</option>
                        <option>Nagpur</option>
                        <option>Mumbai</option>
                        <option>Pune</option>
                        <option>Delhi</option>
                        <option>Bengaluru</option>
                        <option>Hyderabad</option>

                    </select>

                    <button
                        class="primary-btn search-btn"
                        id="searchButton"
                    >
                        Search
                        <b>→</b>
                    </button>

                </div>

                <div class="search-note">
                    HLA is an optional administrative search field.
                    Clinical compatibility decisions must be made by qualified healthcare professionals.
                </div>

            </div>


            <!-- STATS -->

            <div class="stats-grid">

                <article class="stat-card glass-card">

                    <div class="stat-icon blue-icon">♙</div>

                    <div>
                        <span>Registered Donors</span>
                        <strong
                            class="counter"
                            data-value="24860"
                        >
                            0
                        </strong>
                        <small class="positive">+12.8% this month</small>
                    </div>

                </article>


                <article class="stat-card glass-card">

                    <div class="stat-icon cyan-icon">◇</div>

                    <div>
                        <span>Active Camps</span>
                        <strong
                            class="counter"
                            data-value="184"
                        >
                            0
                        </strong>
                        <small>Across 28 regions</small>
                    </div>

                </article>


                <article class="stat-card glass-card">

                    <div class="stat-icon red-icon">+</div>

                    <div>
                        <span>Emergency Requests</span>
                        <strong
                            class="counter"
                            data-value="27"
                        >
                            0
                        </strong>
                        <small class="danger-text">Needs response</small>
                    </div>

                </article>


                <article class="stat-card glass-card">

                    <div class="stat-icon green-icon">✓</div>

                    <div>
                        <span>Lives Supported</span>
                        <strong
                            class="counter"
                            data-value="98142"
                        >
                            0
                        </strong>
                        <small class="positive">Network impact</small>
                    </div>

                </article>

            </div>


            <!-- QUICK ACTIONS -->

            <div class="section-heading">

                <div>
                    <span>CONTROL CENTRE</span>
                    <h2>Everything connected</h2>
                    <p>
                        Move from discovery to response without leaving the platform.
                    </p>
                </div>

            </div>


            <div class="quick-grid">

                <button
                    class="quick-card glass-card"
                    data-section="camps"
                >
                    <div class="quick-icon">◇</div>

                    <div>
                        <h3>Find a Camp</h3>
                        <p>
                            Discover upcoming and ongoing donation camps.
                        </p>
                    </div>

                    <b>→</b>
                </button>


                <button
                    class="quick-card glass-card"
                    data-section="emergency"
                >
                    <div class="quick-icon red-bg">+</div>

                    <div>
                        <h3>Emergency Response</h3>
                        <p>
                            Coordinate an urgent donor mobilisation request.
                        </p>
                    </div>

                    <b>→</b>
                </button>


                <button
                    class="quick-card glass-card"
                    data-section="intelligence"
                >
                    <div class="quick-icon cyan-bg">✦</div>

                    <div>
                        <h3>Intelligence Centre</h3>
                        <p>
                            Explore turnout predictions and mobilisation analytics.
                        </p>
                    </div>

                    <b>→</b>
                </button>


                <button
                    class="quick-card glass-card"
                    data-section="donor"
                >
                    <div class="quick-icon green-bg">♙</div>

                    <div>
                        <h3>Donor Space</h3>
                        <p>
                            Manage profile, consent and donation activity.
                        </p>
                    </div>

                    <b>→</b>
                </button>

            </div>


            <!-- ACTIVE EMERGENCY -->

            <div class="section-heading compact">

                <div>
                    <span>LIVE RESPONSE</span>
                    <h2>Emergency pulse</h2>
                </div>

                <button
                    class="text-action"
                    data-section="emergency"
                >
                    View all →
                </button>

            </div>


            <div
                class="emergency-preview"
                id="emergencyPreview"
            ></div>


            <!-- IMPACT -->

            <div class="impact-banner glass-card">

                <div class="impact-copy">

                    <span>THE BLOOD CONNECT NETWORK</span>

                    <h2>
                        From one donor
                        <span>to a connected response.</span>
                    </h2>

                    <p>
                        Blood Connect creates a digital layer connecting
                        donors, camps, organisers and emergency mobilisation.
                    </p>

                </div>

                <div class="impact-orbit">

                    <div class="orbit-ring ring-a"></div>
                    <div class="orbit-ring ring-b"></div>
                    <div class="orbit-ring ring-c"></div>

                    <div class="orbit-core">
                        <span>BC</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             CAMPS
        ================================================== -->

        <section
            class="page-section"
            id="camps"
        >

            <div class="page-header">

                <div>

                    <div class="eyebrow">
                        <span class="live-indicator"></span>
                        BLOOD CONNECT CAMPS
                    </div>

                    <h1>
                        Discover your next
                        <span>donation camp.</span>
                    </h1>

                    <p>
                        Browse upcoming and ongoing camps across the network.
                    </p>

                </div>

                <button
                    class="primary-btn"
                    id="createCampButton"
                >
                    + Host a Camp
                </button>

            </div>


            <!-- CAMP FILTER BAR -->

            <div class="filter-bar glass-card">

                <div class="filter-search">

                    <span>⌕</span>

                    <input
                        id="campSearch"
                        type="text"
                        placeholder="Search camps or organisations..."
                    >

                </div>

                <select id="campBloodFilter">
                    <option value="">All blood groups</option>
                    <option>A+</option>
                    <option>A-</option>
                    <option>B+</option>
                    <option>B-</option>
                    <option>AB+</option>
                    <option>AB-</option>
                    <option>O+</option>
                    <option>O-</option>
                </select>

                <select id="campLocationFilter">
                    <option value="">All locations</option>
                    <option>Nagpur</option>
                    <option>Mumbai</option>
                    <option>Pune</option>
                    <option>Delhi</option>
                    <option>Bengaluru</option>
                    <option>Hyderabad</option>
                </select>

                <button
                    class="secondary-btn"
                    id="clearCampFilters"
                >
                    Reset
                </button>

            </div>


            <!-- CAMP VIEW SWITCHER & RADAR ACTION -->
            <div class="camps-view-bar">
                <div class="view-toggle-group">
                    <button type="button" class="view-btn active" data-camp-view="cards" id="viewCardsBtn">
                        <span>📋</span> Cards View
                    </button>
                    <button type="button" class="view-btn" data-camp-view="map" id="viewMapBtn">
                        <span>🗺️</span> Interactive Map
                    </button>
                    <button type="button" class="view-btn" data-camp-view="split" id="viewSplitBtn">
                        <span>◫</span> Split View
                    </button>
                </div>

                <button class="primary-btn" id="spotCampsNearMeHeaderBtn" style="padding: 7px 14px; font-size: 12px;">
                    <span>📍</span> Spot Nearby Camps
                </button>
            </div>

            <!-- INTERACTIVE CAMPS MAP WRAPPER -->
            <div class="map-wrapper" id="campsMapWrapper" style="display: none;">
                <div class="map-control-overlay">
                    <button type="button" class="map-action-pill active" id="btnSpotNearMe">
                        <span>📍</span> Spot Near Me (GPS)
                    </button>
                    <select id="mapRadiusSelect" class="map-action-pill" style="cursor: pointer;">
                        <option value="all">Radius: All Regions</option>
                        <option value="5">Within 5 km</option>
                        <option value="10">Within 10 km</option>
                        <option value="25">Within 25 km</option>
                    </select>
                    <button type="button" class="map-action-pill" id="btnFitAllCamps">
                        <span>⊙</span> Reset View
                    </button>
                </div>

                <div id="campsMap" class="leaflet-map-element"></div>

                <div class="map-legend">
                    <div><span class="legend-dot red"></span> Ongoing Camp</div>
                    <div><span class="legend-dot blue"></span> Upcoming Camp</div>
                    <div><span class="legend-dot purple"></span> Your Location</div>
                </div>
            </div>

            <!-- CAMP TABS -->
            <div class="camp-tabs" id="campTabsBar">

                <button
                    class="camp-tab active"
                    data-camp-tab="upcoming"
                >
                    Upcoming Camps
                    <span id="upcomingCount">0</span>
                </button>

                <button
                    class="camp-tab"
                    data-camp-tab="ongoing"
                >
                    Ongoing Camps
                    <span id="ongoingCount">0</span>
                </button>

            </div>


            <!-- CAMP GRID WRAPPER (STANDALONE OR IN SPLIT) -->
            <div id="campDisplayContainer">
                <div
                    class="camp-grid"
                    id="campGrid"
                ></div>
            </div>

        </section>


        <!-- =================================================
             EMERGENCY
        ================================================== -->

        <section
            class="page-section"
            id="emergency"
        >

            <div class="page-header emergency-header">

                <div>

                    <div class="eyebrow red-eyebrow">
                        <span class="live-indicator red-live"></span>
                        EMERGENCY RESPONSE NETWORK
                    </div>

                    <h1>
                        Mobilise the right
                        <span>response.</span>
                    </h1>

                    <p>
                        Create and coordinate urgent donor mobilisation requests.
                    </p>

                </div>

                <div class="emergency-status glass-card">
                    <span class="danger-pulse"></span>
                    <strong>27 active requests</strong>
                    <small>Network status</small>
                </div>

            </div>


            <div class="emergency-layout">

                <!-- REQUEST FORM -->

                <div class="emergency-form-card glass-card">

                    <div class="card-title-row">

                        <div>
                            <span>CREATE REQUEST</span>
                            <h2>Emergency blood request</h2>
                        </div>

                        <div class="red-icon-box">+</div>

                    </div>

                    <form id="emergencyForm">

                        <!-- PATIENT NAME & WARD -->
                        <div class="two-fields">
                            <label class="field">
                                <span>Patient Full Name</span>
                                <input
                                    id="emergencyPatientName"
                                    type="text"
                                    placeholder="Patient name e.g. Aarav Sharma"
                                    required
                                >
                            </label>

                            <label class="field">
                                <span>Ward / ICU / Bed No.</span>
                                <input
                                    id="emergencyPatientWard"
                                    type="text"
                                    placeholder="e.g. ICU Ward 3, Bed 12"
                                >
                            </label>
                        </div>

                        <div class="two-fields">

                            <label class="field">
                                <span>Blood group needed</span>

                                <select id="emergencyBlood" required>
                                    <option value="">Select Blood Group</option>
                                    <option>A+</option>
                                    <option>A-</option>
                                    <option>B+</option>
                                    <option>B-</option>
                                    <option>AB+</option>
                                    <option>AB-</option>
                                    <option>O+</option>
                                    <option>O-</option>
                                </select>
                            </label>

                            <label class="field">
                                <span>Units required</span>
                                <input
                                    id="emergencyUnits"
                                    type="number"
                                    min="1"
                                    max="20"
                                    value="2"
                                    required
                                >
                            </label>

                        </div>

                        <!-- HOSPITAL NAME & CITY -->
                        <div class="two-fields">
                            <label class="field">
                                <span>Hospital / Medical Institution</span>
                                <input
                                    id="emergencyHospital"
                                    type="text"
                                    placeholder="Hospital name e.g. CityCare Hospital"
                                    required
                                >
                            </label>

                            <label class="field">
                                <span>City / Region</span>
                                <input
                                    id="emergencyLocation"
                                    type="text"
                                    placeholder="e.g. Nagpur"
                                    required
                                >
                            </label>
                        </div>

                        <!-- LIVE HOSPITAL LOCATION PICKER -->
                        <div class="hospital-picker-box">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                <span style="font-size: 12px; font-weight: 800; color: var(--text);">📍 HOSPITAL LIVE LOCATION & MAP PIN</span>
                                <button type="button" class="upload-pill" id="btnDetectHospitalGPS" style="margin-top: 0; padding: 4px 10px; font-size: 11px;">
                                    <span>🧭</span> Use Current GPS
                                </button>
                            </div>

                            <label class="field" style="margin-bottom: 8px;">
                                <span>Hospital Full Street Address</span>
                                <input
                                    id="emergencyHospitalAddress"
                                    type="text"
                                    placeholder="Exact street / campus address where donor must report"
                                    required
                                >
                            </label>

                            <div class="two-fields" style="margin-bottom: 6px;">
                                <label class="field">
                                    <span>Hospital Quick Preset</span>
                                    <select id="hospitalPresetSelect">
                                        <option value="">-- Choose verified hospital pin --</option>
                                        <option value="21.1458,79.0882,Nagpur GMC,Medical Square, Nagpur">Govt Medical College & Hospital, Nagpur</option>
                                        <option value="21.0782,79.0285,AIIMS Nagpur,MIHAN SEZ, Nagpur">AIIMS Nagpur, MIHAN</option>
                                        <option value="19.0522,72.8295,Lilavati Hospital,Bandra West, Mumbai">Lilavati Hospital & Research Centre, Mumbai</option>
                                        <option value="19.0026,72.8423,KEM Hospital,Parel, Mumbai">KEM Hospital, Parel, Mumbai</option>
                                        <option value="18.5332,73.8778,Ruby Hall Clinic,Sassoon Road, Pune">Ruby Hall Clinic, Pune</option>
                                        <option value="28.5672,77.2100,AIIMS Delhi,Ansari Nagar, New Delhi">AIIMS, New Delhi</option>
                                    </select>
                                </label>

                                <label class="field">
                                    <span>Live GPS Coordinates (Lat, Lng)</span>
                                    <input
                                        id="emergencyCoords"
                                        type="text"
                                        placeholder="21.1458, 79.0882"
                                        value="21.1458, 79.0882"
                                        readonly
                                    >
                                </label>
                            </div>

                            <div id="hospitalPinBadge" class="hospital-live-pin-banner">
                                <span>📍 Hospital Live Pin: <b id="pinCoordText">21.1458, 79.0882 (CityCare Medical)</b></span>
                                <span style="color: var(--green); font-size: 11px;">● Ready to Broadcast</span>
                            </div>

                            <div id="hospitalPickerMap" class="mini-map-element"></div>
                            <small class="field-hint">Click on map above to adjust hospital pin position precisely.</small>
                        </div>

                        <label class="field">
                            <span>Attendant Contact Phone</span>
                            <input
                                id="emergencyContact"
                                type="tel"
                                placeholder="+91 XXXXX XXXXX"
                                required
                            >
                        </label>

                        <div class="urgency-selector">

                            <span>Urgency</span>

                            <div class="urgency-options">

                                <label>
                                    <input
                                        type="radio"
                                        name="urgency"
                                        value="Critical"
                                        checked
                                    >
                                    <span class="critical-option">Critical (Immediate)</span>
                                </label>

                                <label>
                                    <input
                                        type="radio"
                                        name="urgency"
                                        value="High"
                                    >
                                    <span class="high-option">High (Within 2 hrs)</span>
                                </label>

                                <label>
                                    <input
                                        type="radio"
                                        name="urgency"
                                        value="Moderate"
                                    >
                                    <span class="moderate-option">Moderate</span>
                                </label>

                            </div>

                        </div>

                        <label class="field">
                            <span>Clinical / Attendant Note</span>
                            <textarea
                                id="emergencyNote"
                                rows="2"
                                placeholder="Patient bed details, emergency contact, replacement info..."
                            ></textarea>
                        </label>

                        <button
                            class="danger-button wide"
                            type="submit"
                            id="btnBroadcastSOS"
                        >
                            <span>🚨 Broadcast Emergency SOS to Donors</span>
                            <b>→</b>
                        </button>

                    </form>

                </div>


                <!-- MATCHING PANEL -->

                <div class="matching-panel">

                    <div class="matching-card glass-card">

                        <div class="card-title-row">

                            <div>
                                <span>MOBILISATION ENGINE</span>
                                <h2>Response chain</h2>
                            </div>

                            <div class="matching-live">
                                LIVE
                            </div>

                        </div>

                        <div class="response-chain">

                            <div class="chain-step completed">
                                <span>1</span>
                                <strong>Notified</strong>
                                <small>1,284</small>
                            </div>

                            <div class="chain-line"></div>

                            <div class="chain-step completed">
                                <span>2</span>
                                <strong>Opened</strong>
                                <small>864</small>
                            </div>

                            <div class="chain-line"></div>

                            <div class="chain-step active-chain">
                                <span>3</span>
                                <strong>Interested</strong>
                                <small>318</small>
                            </div>

                            <div class="chain-line"></div>

                            <div class="chain-step">
                                <span>4</span>
                                <strong>Committed</strong>
                                <small>126</small>
                            </div>

                            <div class="chain-line"></div>

                            <div class="chain-step">
                                <span>5</span>
                                <strong>Completed</strong>
                                <small>94</small>
                            </div>

                        </div>

                    </div>


                    <div class="broadcast-card glass-card">

                        <div class="broadcast-head">

                            <div>
                                <span>ADAPTIVE BROADCAST</span>
                                <h2>Mobilisation radius</h2>
                            </div>

                            <strong id="radiusValue">25 km</strong>

                        </div>

                        <input
                            id="radiusSlider"
                            type="range"
                            min="5"
                            max="50"
                            value="25"
                            step="5"
                        >

                        <div class="range-labels">
                            <span>5 km</span>
                            <span>25 km</span>
                            <span>50 km</span>
                        </div>

                        <div class="reachable-donors">

                            <span>Potentially reachable opted-in donors</span>

                            <strong id="reachableCount">
                                1,284
                            </strong>

                        </div>

                        <button
                            class="secondary-btn wide"
                            id="expandBroadcast"
                        >
                            Expand mobilisation radius
                            <span>↗</span>
                        </button>

                    </div>

                </div>

            </div>


            <!-- LIVE EMERGENCY RADAR MAP -->
            <div class="map-wrapper" id="emergencyMapWrapper">
                <div class="map-control-overlay">
                    <span style="font-size: 11.5px; font-weight: 800; color: var(--red); display: flex; align-items: center; gap: 6px;">
                        <span class="danger-pulse" style="width: 8px; height: 8px;"></span> EMERGENCY MOBILISATION RADAR
                    </span>
                    <button type="button" class="map-action-pill" id="btnFocusHospital">
                        <span>🏥</span> Focus Hospital Pin
                    </button>
                    <button type="button" class="map-action-pill" id="btnSimulateDonorPing">
                        <span>📡</span> Ping Donors in Radius
                    </button>
                </div>

                <div id="emergencyMap" class="leaflet-map-element emergency-map-element"></div>

                <div class="map-legend">
                    <div><span class="legend-dot red"></span> Emergency Hospital Pin</div>
                    <div><span class="legend-dot green"></span> Active Donors (<span id="radarDonorCount">18</span> nearby)</div>
                    <div><span class="legend-dot purple"></span> Broadcast Radius (<span id="mapRadiusIndicator">25</span> km)</div>
                </div>
            </div>


            <!-- EMERGENCY FEED -->

            <div class="section-heading compact">

                <div>
                    <span>LIVE FEED</span>
                    <h2>Active emergency requests</h2>
                </div>

            </div>

            <div
                class="emergency-list"
                id="emergencyList"
            ></div>

        </section>


        <!-- =================================================
             RECIPIENT SPACE (FOR PATIENTS & HOSPITALS)
        ================================================== -->

        <section
            class="page-section"
            id="recipient"
        >

            <div class="page-header">

                <div>

                    <div class="eyebrow red-eyebrow">
                        <span class="live-indicator red-live"></span>
                        RECIPIENT & PATIENT CARE SPACE
                    </div>

                    <h1>
                        Empowered response,
                        <span>when seconds count.</span>
                    </h1>

                    <p>
                        Track emergency blood requests, verify hospital admissions, monitor responding donors, and coordinate patient care.
                    </p>

                </div>

                <button
                    class="primary-btn"
                    id="recipientNewSOSBtn"
                    style="background: linear-gradient(135deg, var(--red), var(--coral));"
                >
                    + Create Emergency Request
                    <span>↗</span>
                </button>

            </div>


            <div class="recipient-layout">

                <!-- LEFT COLUMN: RECIPIENT PROFILE & ACTIVE REQUESTS -->
                <div class="space-y-6">

                    <!-- PROFILE CARD -->
                    <div class="profile-card glass-card">

                        <div class="profile-cover" style="background: linear-gradient(135deg, rgba(225,29,72,0.6), rgba(37,99,235,0.7));"></div>

                        <div class="profile-body">

                            <div class="large-avatar" id="recipientLargeAvatar" style="background: linear-gradient(135deg, var(--red), #881337); border-color: rgba(255,255,255,0.9);">
                                RC
                            </div>

                            <div class="profile-name">

                                <h2 id="recipientProfileName">
                                    Rajesh Kumar
                                </h2>

                                <span id="recipientTypeBadge">
                                    Verified Recipient • Individual
                                </span>

                            </div>

                            <button
                                class="icon-action"
                                id="editRecipientProfile"
                            >
                                ✎
                            </button>

                        </div>

                        <div class="profile-details">

                            <div>
                                <span>Blood Group Needed</span>
                                <strong id="recipientBloodNeeded" style="color: var(--red);">B+</strong>
                            </div>

                            <div>
                                <span>ID Proof</span>
                                <strong id="recipientIdProof">Aadhaar Verified ✓</strong>
                            </div>

                            <div>
                                <span>City / Region</span>
                                <strong id="recipientCity">Nagpur</strong>
                            </div>

                            <div>
                                <span>Recipient ID</span>
                                <strong id="recipientIdCode">BC-REC-9281</strong>
                            </div>

                        </div>

                    </div>


                    <!-- ACTIVE RECIPIENT REQUESTS -->
                    <div class="glass-card" style="padding: 24px; border-radius: var(--radius-xl);">

                        <div class="card-title-row">
                            <div>
                                <span>LIVE TRACKER</span>
                                <h2>Your Active Blood Requests</h2>
                            </div>
                            <span class="recipient-badge-tag">● BROADCAST ACTIVE</span>
                        </div>

                        <div id="recipientActiveRequestsList" style="margin-top: 14px; display: flex; flex-direction: column; gap: 14px;">
                            <!-- Populated dynamically via JS -->
                        </div>

                    </div>

                </div>


                <!-- RIGHT COLUMN: HOSPITAL ADMISSION & MATCHED DONORS -->
                <div class="space-y-6">

                    <!-- HOSPITAL ADMISSION CARD -->
                    <div class="glass-card" style="padding: 24px; border-radius: var(--radius-xl);">

                        <div class="card-title-row">
                            <div>
                                <span>CURRENT ADMISSION</span>
                                <h2>Hospital & Patient Details</h2>
                            </div>
                            <span style="font-size: 20px;">🏥</span>
                        </div>

                        <div class="hospital-admission-box">
                            <div style="font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase; margin-bottom: 4px;">Admitted Hospital</div>
                            <h3 id="recipHospitalName" style="font-size: 16px; font-weight: 800; color: var(--text);">CityCare Medical Institute</h3>
                            <p id="recipHospitalAddr" style="font-size: 12px; color: var(--muted); margin-top: 2px;">Ward 4B, Bed 18 • Civil Lines, Nagpur</p>

                            <div style="margin-top: 12px; display: flex; gap: 8px;">
                                <button type="button" class="upload-pill" id="btnViewHospitalOnMapRecip" style="margin-top: 0;">
                                    <span>📍</span> View Hospital on Map
                                </button>
                                <button type="button" class="upload-pill" id="btnCallHospitalDoctor" style="margin-top: 0; color: var(--green); border-color: var(--green); background: rgba(16,185,129,0.08);">
                                    <span>📞</span> Call Attendant
                                </button>
                            </div>
                        </div>

                        <div style="margin-top: 14px; font-size: 12px; color: var(--muted); line-height: 1.5;">
                            <b>Emergency Hotline:</b> 108 / 102. For immediate transport, the platform automatically shares the hospital GPS route with enrolled ambulance volunteers.
                        </div>

                    </div>


                    <!-- NEARBY MATCHING DONORS RADAR -->
                    <div class="glass-card" style="padding: 24px; border-radius: var(--radius-xl);">

                        <div class="card-title-row">
                            <div>
                                <span>DONOR RADAR</span>
                                <h2>Matched Donors Nearby</h2>
                            </div>
                            <span class="live-indicator"></span>
                        </div>

                        <p style="font-size: 12px; color: var(--muted); margin-top: 4px;">
                            Verified donors matching your blood group within 15 km of your hospital.
                        </p>

                        <div class="donor-match-list" id="recipientMatchedDonors">
                            <!-- Populated dynamically via JS -->
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             INTELLIGENCE
        ================================================== -->

        <section
            class="page-section"
            id="intelligence"
        >

            <div class="page-header">

                <div>

                    <div class="eyebrow">
                        <span class="live-indicator"></span>
                        BLOOD CONNECT INTELLIGENCE
                    </div>

                    <h1>
                        Understand mobilisation
                        <span>before it happens.</span>
                    </h1>

                    <p>
                        Prototype analytics for camp turnout, engagement and response.
                    </p>

                </div>

                <button
                    class="secondary-btn"
                    id="demoModeButton"
                >
                    Run Demo Scenario
                    <span>✦</span>
                </button>

            </div>


            <!-- KPI -->

            <div class="analytics-kpis">

                <div class="analytics-kpi glass-card">
                    <span>Registrations</span>
