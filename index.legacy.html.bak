                    <div>
                        <span>Ticket ID</span>
                        <strong id="passTicket">BC-TKT-48291</strong>
                    </div>

                </div>

            </div>

            <div class="qr-box">

                <div class="fake-qr" id="fakeQR">
                    <span>BC</span>
                </div>

                <small>Scan at camp</small>

            </div>

        </div>

        <div class="pass-actions">

            <button
                class="secondary-btn"
                id="printPass"
            >
                Print Pass
            </button>

            <button
                class="primary-btn"
                id="downloadPass"
            >
                Download
                <span>↓</span>
            </button>

        </div>

    </div>

</div>


<!-- =========================================================
     CREATE CAMP MODAL
========================================================= -->

<div
    class="modal-overlay"
    id="createCampModal"
>

    <div class="modal-card glass-card">

        <button
            class="modal-close"
            data-close="createCampModal"
        >
            ×
        </button>

        <div class="modal-title">

            <span>ORGANISER TOOLS</span>

            <h2>Create a camp</h2>

            <p>
                Create a new demo camp and generate its registration card.
            </p>

        </div>

        <form id="createCampForm">

            <label class="field">
                <span>Camp name</span>
                <input
                    id="newCampName"
                    type="text"
                    placeholder="Community Blood Mobilisation Camp"
                    required
                >
            </label>

            <div class="two-fields">

                <label class="field">
                    <span>Location</span>
                    <input
                        id="newCampLocation"
                        type="text"
                        placeholder="Nagpur"
                        required
                    >
                </label>

                <label class="field">
                    <span>Date</span>
                    <input
                        id="newCampDate"
                        type="date"
                        required
                    >
                </label>

            </div>

            <label class="field">
                <span>Venue</span>
                <input
                    id="newCampVenue"
                    type="text"
                    placeholder="Community Hall"
                    required
                >
            </label>

            <div class="two-fields">

                <label class="field">
                    <span>Target donors</span>
                    <input
                        id="newCampTarget"
                        type="number"
                        min="10"
                        value="100"
                        required
                    >
                </label>

                <label class="field">
                    <span>Organisation</span>
                    <input
                        id="newCampOrg"
                        type="text"
                        placeholder="Organisation"
                        required
                    >
                </label>

            </div>

            <button
                class="primary-btn wide"
                type="submit"
            >
                Create Camp
                <span>→</span>
            </button>

        </form>

    </div>

</div>


<!-- =========================================================
     PROFILE MODAL
========================================================= -->

<div
    class="modal-overlay"
    id="profileModal"
>

    <div class="modal-card glass-card">

        <button
            class="modal-close"
            data-close="profileModal"
        >
            ×
        </button>

        <div class="modal-title">

            <span>ACCOUNT</span>

            <h2>Profile</h2>

        </div>

        <div class="profile-menu">

            <button data-section="donor" id="profileDonorBtn">
                <span>♙</span>
                My Donor Space
            </button>

            <button data-section="recipient" id="profileRecipientBtn">
                <span>🏥</span>
                Recipient Space
            </button>

            <button id="profileScanner">
                <span>⌁</span>
                Camp Scanner
            </button>

            <button data-section="audit">
                <span>◇</span>
                Audit & Security
            </button>

            <button id="logoutButton">
                <span>↪</span>
                Log out
            </button>

        </div>

    </div>

</div>


<!-- =========================================================
     EMERGENCY BROADCAST LIVE SOS MODAL
========================================================= -->

<div
    class="modal-overlay"
    id="emergencyBroadcastModal"
>

    <div class="modal-card glass-card broadcast-modal-card">

        <button
            class="modal-close"
            data-close="emergencyBroadcastModal"
        >
            ×
        </button>

        <div class="broadcast-alert-banner">
            <span class="pulse-alert-icon">🚨</span>
            <div>
                <strong style="color: var(--red); font-size: 15px; display: block;">LIVE EMERGENCY SOS BROADCAST ACTIVE</strong>
                <p style="font-size: 12px; margin-top: 2px;">
                    Sent to <b><span id="broadcastNotifiedDonors">1,284</span> registered donors</b> within <span id="broadcastRadiusText">25 km</span> with live hospital location pin.
                </p>
            </div>
        </div>

        <div class="glass-card" style="padding: 16px; margin-bottom: 14px; background: rgba(37,99,235,0.06);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <span style="font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase;">Admitted Patient</span>
                    <h3 id="broadcastPatientName" style="font-size: 18px; font-weight: 800; color: var(--text); margin-top: 2px;">Patient Name</h3>
                    <p id="broadcastHospitalName" style="font-size: 13px; color: var(--muted); margin-top: 2px;">Hospital Name & Address</p>
                </div>
                <div style="text-align: right;">
                    <span class="danger-badge" id="broadcastBloodBadge" style="font-size: 14px; padding: 4px 12px; border-radius: 8px; background: var(--red); color: #fff; font-weight: 800;">O+</span>
                    <div style="font-size: 12px; color: var(--muted); margin-top: 4px;"><span id="broadcastUnits">2</span> Units Required</div>
                </div>
            </div>

            <div style="margin-top: 12px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; border-top: 1px dashed var(--glass-border); padding-top: 8px;">
                <span>📍 Hospital Live Pin: <b id="broadcastCoordinates">21.1458, 79.0882</b></span>
                <a id="broadcastMapsLink" href="https://maps.google.com" target="_blank" class="upload-pill" style="margin-top: 0; text-decoration: none;">
                    <span>🗺️</span> Open Navigation
                </a>
            </div>
        </div>

        <div style="font-size: 12px; font-weight: 800; color: var(--text); text-transform: uppercase; margin-bottom: 6px; display: flex; align-items: center; justify-content: space-between;">
            <span>Simulated Donor Response Stream:</span>
            <span class="live-indicator"></span>
        </div>

        <div class="donor-response-ticker" id="broadcastTickerList">
            <!-- Simulated responses populate here -->
        </div>

        <div style="display: flex; gap: 10px; margin-top: 16px;">
            <button class="primary-btn wide" id="broadcastAckBtn" style="background: linear-gradient(135deg, var(--green), #059669);">
                <span>✓ Acknowledge & View on Live Radar</span>
            </button>
        </div>

    </div>

</div>


<!-- =========================================================
     TOAST
========================================================= -->

<div
    class="toast-container"
    id="toastContainer"
></div>

<!-- LEAFLET JAVASCRIPT FOR INTERACTIVE MAPS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script src="script.js"></script>

</body>
</html>
